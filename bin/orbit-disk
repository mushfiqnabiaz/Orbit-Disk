#!/usr/bin/env bash
# ==============================================================================
# Orbit-Disk - Satellite Storage & Cache Offloader for macOS Developers
# https://github.com/mushfiqnabiaz/Orbit-Disk
# ==============================================================================

set -e

ORBIT_VERSION="1.1.0"
CONFIG_FILE="${HOME}/.orbit-disk.conf"
LEGACY_CONF="${HOME}/.devdrive.conf"

# Backward compatibility with legacy conf
if [ ! -f "$CONFIG_FILE" ] && [ -f "$LEGACY_CONF" ]; then
    CONFIG_FILE="$LEGACY_CONF"
fi

# Default configuration
ORBIT_PATH="${ORBIT_PATH:-auto}"

# Default feature toggles
OFFLOAD_XDG_CACHE="${OFFLOAD_XDG_CACHE:-true}"
OFFLOAD_HOMEBREW="${OFFLOAD_HOMEBREW:-true}"
OFFLOAD_NPM="${OFFLOAD_NPM:-true}"
OFFLOAD_PNPM="${OFFLOAD_PNPM:-true}"
OFFLOAD_BUN="${OFFLOAD_BUN:-true}"
OFFLOAD_ANDROID="${OFFLOAD_ANDROID:-true}"
OFFLOAD_GRADLE="${OFFLOAD_GRADLE:-true}"
OFFLOAD_GO="${OFFLOAD_GO:-true}"
OFFLOAD_CARGO="${OFFLOAD_CARGO:-true}"
OFFLOAD_PLAYWRIGHT="${OFFLOAD_PLAYWRIGHT:-true}"
OFFLOAD_AI_MODELS="${OFFLOAD_AI_MODELS:-true}"

# Load user configuration if present
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

# Detect external drive if set to "auto"
get_drive_path() {
    if [ "$ORBIT_PATH" != "auto" ] && [ -n "$ORBIT_PATH" ] && [ -d "$ORBIT_PATH" ]; then
        echo "$ORBIT_PATH"
        return 0
    fi

    # Auto-detect mounted external volumes in /Volumes
    for vol in /Volumes/*; do
        if [ "$vol" = "/Volumes/Macintosh HD" ] || [ "$vol" = "/Volumes/Macintosh HD - Data" ] || [ ! -d "$vol" ]; then
            continue
        fi
        if [ -w "$vol" ] && [ ! -f "$vol/.read-only" ]; then
            echo "$vol"
            return 0
        fi
    done

    echo ""
    return 1
}

TARGET_DIR="$(get_drive_path || true)"

show_banner() {
    cat << "EOF"
   ____       __    _ __        ____  _     __  
  / __ \_____/ /_  (_) /_      / __ \(_)___/ /__
 / / / / ___/ __ \/ / __/_____/ / / / / ___/ //_/
/ /_/ / /  / /_/ / / /_/_____/ /_/ / (__  ) ,<   
\____/_/  /_.___/_/\__/     /_____/_/____/_/|_|  
                                                 
   Satellite Storage for macOS Developers (v1.1.0)
EOF
}

cmd_status() {
    show_banner
    echo ""
    echo "⚙️  Configuration: $CONFIG_FILE"
    
    if [ -n "$TARGET_DIR" ] && [ -d "$TARGET_DIR" ]; then
        echo "🟢 Drive Status:   DOCKED (In Orbit)"
        echo "📍 Target Volume:  $TARGET_DIR"
        
        if command -v df >/dev/null 2>&1; then
            echo "💾 Available:      $(df -h "$TARGET_DIR" | awk 'NR==2 {print $4 " (" $5 " used)"}')"
        fi
        
        echo ""
        echo "📦 Offloaded Cache Paths:"
        [ "$OFFLOAD_XDG_CACHE" = "true" ] && echo "   • XDG Cache:     $TARGET_DIR/.cache"
        [ "$OFFLOAD_HOMEBREW" = "true" ]  && echo "   • Homebrew:      $TARGET_DIR/Caches/Homebrew"
        [ "$OFFLOAD_NPM" = "true" ]       && echo "   • NPM Cache:     $TARGET_DIR/.npm-cache"
        [ "$OFFLOAD_PNPM" = "true" ]      && echo "   • PNPM Store:    $TARGET_DIR/.pnpm"
        [ "$OFFLOAD_BUN" = "true" ]       && echo "   • Bun Cache:     $TARGET_DIR/.bun-cache"
        [ "$OFFLOAD_ANDROID" = "true" ]   && echo "   • Android AVD:   $TARGET_DIR/.android/avd"
        [ "$OFFLOAD_GRADLE" = "true" ]    && echo "   • Gradle Home:   $TARGET_DIR/.gradle"
        [ "$OFFLOAD_GO" = "true" ]        && echo "   • Go Build:      $TARGET_DIR/Caches/go-build"
        [ "$OFFLOAD_CARGO" = "true" ]     && echo "   • Rust Cargo:    $TARGET_DIR/.cargo"
        [ "$OFFLOAD_PLAYWRIGHT" = "true" ]&& echo "   • Playwright:    $TARGET_DIR/Caches/ms-playwright"
        [ "$OFFLOAD_AI_MODELS" = "true" ] && echo "   • AI (Ollama/HF):$TARGET_DIR/ollama/models & $TARGET_DIR/.cache/huggingface"
        echo ""
        echo "🛡️  Spotlight Guard: Active (caches, emulators & DBs excluded from search churn)"
    else
        echo "🟡 Drive Status:   UNDOCKED (Zero-break internal fallback mode active)"
        echo "ℹ️  Caches are safely routed to internal drive until external drive is docked."
    fi
}

cmd_init() {
    show_banner
    echo ""
    echo "🔍 Scanning for connected external drives..."
    echo ""
    
    local options=()
    local i=1
    
    for vol in /Volumes/*; do
        if [ "$vol" = "/Volumes/Macintosh HD" ] || [ "$vol" = "/Volumes/Macintosh HD - Data" ] || [ ! -d "$vol" ]; then
            continue
        fi
        if [ -w "$vol" ]; then
            options+=("$vol")
            echo "   [$i] $vol ($(df -h "$vol" | awk 'NR==2 {print $4 " free"}'))"
            i=$((i + 1))
        fi
    done

    if [ ${#options[@]} -eq 0 ]; then
        echo "❌ No writable external storage found in /Volumes."
        echo "Please plug in an external drive and re-run 'orbit-disk init'."
        exit 1
    fi

    echo ""
    printf "Select target drive [1-%s] (Enter for [1]): " "${#options[@]}"
    if [ -t 0 ]; then
        read -r choice || choice=1
    elif [ -c /dev/tty ]; then
        read -r choice < /dev/tty 2>/dev/null || choice=1
    else
        choice=1
    fi
    choice="${choice:-1}"
    
    local selected_idx=$((choice - 1))
    local chosen_drive="${options[$selected_idx]}"

    if [ -z "$chosen_drive" ] || [ ! -d "$chosen_drive" ]; then
        echo "❌ Invalid selection."
        exit 1
    fi

    CONFIG_FILE="${HOME}/.orbit-disk.conf"
    echo "Saving settings to $CONFIG_FILE..."
    cat > "$CONFIG_FILE" << EOF
# Orbit-Disk configuration (v1.1.0)
ORBIT_PATH="$chosen_drive"

# Web & Package Caches
OFFLOAD_XDG_CACHE=true
OFFLOAD_HOMEBREW=true
OFFLOAD_NPM=true
OFFLOAD_PNPM=true
OFFLOAD_BUN=true

# Mobile & Android
OFFLOAD_ANDROID=true
OFFLOAD_GRADLE=true

# Language Runtimes & Testing
OFFLOAD_GO=true
OFFLOAD_CARGO=true
OFFLOAD_PLAYWRIGHT=true

# Local AI Models (Ollama, HuggingFace)
OFFLOAD_AI_MODELS=true

PREVENT_SPOTLIGHT_INDEXING=true
EOF

    # Prepare directories on target drive
    mkdir -p "$chosen_drive"/{.cache,.npm-cache,.pnpm,.bun-cache,.android/avd,.gradle,.cargo,Caches/Homebrew,Caches/go-build,Caches/ms-playwright,ollama/models,Projects,Applications}
    touch "$chosen_drive/.cache/.metadata_never_index" 2>/dev/null || true
    touch "$chosen_drive/.android/.metadata_never_index" 2>/dev/null || true
    touch "$chosen_drive/.gradle/.metadata_never_index" 2>/dev/null || true

    echo "✅ Successfully docked Orbit-Disk to: $chosen_drive"
    echo "💡 Run 'source ~/.zshrc' to apply."
}

cmd_sweep() {
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "⚠️  External drive not connected. Cannot sweep caches."
        exit 1
    fi

    echo "🧹 Sweeping internal fallback caches into orbit ($TARGET_DIR)..."
    python3 -c "
import os, shutil

def get_size(path):
    if os.path.isfile(path) or os.path.islink(path):
        try: return os.path.getsize(path)
        except: return 0
    total = 0
    for root, dirs, files in os.walk(path):
        for f in files:
            fp = os.path.join(root, f)
            try: total += os.path.getsize(fp)
            except: pass
    return total

def fmt_size(b):
    for u in ['B', 'KB', 'MB', 'GB']:
        if b < 1024.0: return f'{b:.1f} {u}'
        b /= 1024.0
    return f'{b:.1f} TB'

src = os.path.expanduser('~/.cache')
dst = os.path.join('$TARGET_DIR', '.cache')
moved = []

if os.path.exists(src) and os.path.exists(dst):
    for f in sorted(os.listdir(src)):
        if f.startswith('.'): continue
        s = os.path.join(src, f)
        d = os.path.join(dst, f)
        try:
            sz = get_size(s)
            if os.path.isdir(s):
                shutil.copytree(s, d, dirs_exist_ok=True)
                shutil.rmtree(s)
                moved.append((f, sz, 'folder'))
            elif os.path.isfile(s):
                shutil.copy2(s, d)
                os.remove(s)
                moved.append((f, sz, 'file'))
        except Exception:
            pass

pnpm_local = os.path.expanduser('~/.pnpm-store')
if os.path.exists(pnpm_local):
    try:
        sz = get_size(pnpm_local)
        shutil.rmtree(pnpm_local)
        moved.append(('.pnpm-store', sz, 'store'))
    except Exception:
        pass

if moved:
    print('📦 Shifted the following caches from internal drive to external SSD:')
    for name, size, kind in moved:
        print(f'   • {name} ({fmt_size(size)})')
    print(f'✅ Successfully swept {len(moved)} cache item(s)!')
else:
    print('✨ Internal drive is already clean. Nothing to sweep.')
"
}

cmd_install_app() {
    local app="$1"
    if [ -z "$app" ]; then
        echo "Usage: orbit-disk install-app <cask-name>"
        exit 1
    fi
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "⚠️  External drive not connected."
        exit 1
    fi

    echo "📦 Installing $app to $TARGET_DIR via Homebrew..."
    brew install --cask --appdir="$TARGET_DIR" "$app"
    
    echo "🔗 Auto-linking to /Applications..."
    python3 -c "
import os
target = '$TARGET_DIR'
for f in os.listdir(target):
    if f.endswith('.app'):
        src = os.path.join(target, f)
        dst = os.path.join('/Applications', f)
        if not os.path.exists(dst):
            os.symlink(src, dst)
            print(f'✅ Linked {f} into /Applications')
"
}

cmd_install_dmg() {
    local dmg="$1"
    if [ ! -f "$dmg" ]; then
        echo "❌ File not found: $dmg"
        exit 1
    fi
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "⚠️  External drive not connected."
        exit 1
    fi

    echo "📦 Mounting $dmg..."
    local mount_point
    mount_point=$(hdiutil attach "$dmg" -nobrowse -readonly | grep -E "/Volumes/" | awk '{print $NF}')
    if [ -z "$mount_point" ]; then
        echo "❌ Failed to mount DMG."
        exit 1
    fi

    echo "🚀 Copying app to $TARGET_DIR..."
    cp -a "$mount_point"/*.app "$TARGET_DIR/" 2>/dev/null || true
    echo "⏏️ Ejecting $mount_point..."
    hdiutil detach "$mount_point" -quiet
    rm -f "$dmg"

    echo "🔗 Auto-linking to /Applications..."
    python3 -c "
import os
target = '$TARGET_DIR'
for f in os.listdir(target):
    if f.endswith('.app'):
        src = os.path.join(target, f)
        dst = os.path.join('/Applications', f)
        if not os.path.exists(dst):
            os.symlink(src, dst)
            print(f'✅ Linked {f} into /Applications')
"
    echo "✅ Successfully installed and linked!"
}

cmd_clean_next() {
    echo "🧹 Removing all .next build caches in $(pwd)..."
    find . -name '.next' -type d -prune -exec rm -rf {} +
    echo "✅ Cleaned all .next build caches."
}

cmd_clean_modules() {
    echo "🧹 Removing all node_modules in $(pwd)..."
    find . -name 'node_modules' -type d -prune -exec rm -rf {} +
    echo "✅ Cleaned all node_modules."
}

cmd_update() {
    echo "🛰️ Checking for Orbit-Disk updates from GitHub..."
    local raw_base="https://raw.githubusercontent.com/mushfiqnabiaz/Orbit-Disk/main"
    local install_dir="${HOME}/.local/bin"
    local clone_dir="${HOME}/.orbit-disk"
    local plugin_dest="${HOME}/.orbit-disk.plugin.zsh"
    local alert_file="${HOME}/.orbit-disk-update-alert"

    local tmp_dir
    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' EXIT

    if curl -fsSL "${raw_base}/bin/orbit-disk" -o "${tmp_dir}/orbit-disk" && \
       curl -fsSL "${raw_base}/orbit-disk.plugin.zsh" -o "${tmp_dir}/orbit-disk.plugin.zsh"; then
        chmod +x "${tmp_dir}/orbit-disk"
        local new_ver
        new_ver="$("${tmp_dir}/orbit-disk" --version 2>/dev/null || echo "orbit-disk latest")"

        # Atomically install
        mkdir -p "$install_dir"
        mv "${tmp_dir}/orbit-disk" "${install_dir}/orbit-disk"
        ln -sf "${install_dir}/orbit-disk" "${install_dir}/orbit"
        cp "${tmp_dir}/orbit-disk.plugin.zsh" "$plugin_dest"

        # If git clone dir exists, sync it too
        if [ -d "$clone_dir/.git" ]; then
            (cd "$clone_dir" && git pull --quiet origin main 2>/dev/null || true)
        fi

        # Sync fish plugin if fish is configured
        if [ -d "${HOME}/.config/fish/conf.d" ]; then
            curl -fsSL "${raw_base}/orbit-disk.fish" -o "${HOME}/.config/fish/conf.d/orbit-disk.fish" 2>/dev/null || true
        fi

        rm -f "$alert_file"
        echo ""
        echo "🎉 Successfully updated to ${new_ver}!"
        echo "👉 Run 'source ~/.zshrc' to apply shell changes to this session."
    else
        echo "❌ Update failed: could not connect to GitHub repository."
        return 1
    fi
}

cmd_doctor() {
    show_banner
    echo ""
    echo "🩺 Orbit-Disk Diagnostic Health Check"
    echo "======================================"
    echo ""

    # 1. Configuration Check
    echo "⚙️  Configuration:"
    if [ -f "$CONFIG_FILE" ]; then
        echo "   ✅ Config file: $CONFIG_FILE"
        echo "      ORBIT_PATH is set to: $ORBIT_PATH"
    else
        echo "   ⚠️  No config file found at ~/.orbit-disk.conf (run 'orbit init')"
    fi

    # 2. Satellite Drive Health
    echo ""
    echo "🛰️  Satellite Volume Health:"
    if [ -n "$TARGET_DIR" ] && [ -d "$TARGET_DIR" ]; then
        echo "   ✅ Mounted & Active: $TARGET_DIR"

        local test_file="$TARGET_DIR/.orbit_rw_test_$$"
        if touch "$test_file" 2>/dev/null && rm -f "$test_file" 2>/dev/null; then
            echo "   ✅ Read/Write Permissions: Verified (Full RW access)"
        else
            echo "   ❌ Read/Write Permissions: FAILED (Volume may be read-only)"
        fi

        if command -v diskutil >/dev/null 2>&1; then
            local fs_type
            fs_type=$(diskutil info "$TARGET_DIR" 2>/dev/null | awk -F': ' '/Type \(Bundle\)|File System Personality/ {print $2}' | head -n 1)
            [ -n "$fs_type" ] && echo "   ℹ️  Filesystem: $fs_type"
        fi

        if command -v df >/dev/null 2>&1; then
            local free_vol
            free_vol=$(df -h "$TARGET_DIR" | awk 'NR==2 {print $4 " (" $5 " used)"}')
            echo "   💾 Available Space: $free_vol"
        fi
    else
        echo "   🟡 Drive is currently UNDOCKED"
        echo "      Orbit-Disk is active in transparent internal fallback mode."
        echo "      Caches and builds continue seamlessly without crashing."
    fi

    # 3. Shell Hook Integration
    echo ""
    echo "🐚 Shell Hook Check:"
    local zshrc="${HOME}/.zshrc"
    if [ -f "$zshrc" ] && grep -q "orbit-disk.plugin.zsh" "$zshrc"; then
        echo "   ✅ Zsh plugin hook present in ~/.zshrc"
    else
        echo "   ⚠️  Zsh hook missing in ~/.zshrc (run installer to add)"
    fi

    if [ -f "${HOME}/.orbit-disk.plugin.zsh" ]; then
        echo "   ✅ Plugin script exists at ~/.orbit-disk.plugin.zsh"
    else
        echo "   ⚠️  Plugin script not found at ~/.orbit-disk.plugin.zsh"
    fi

    # 4. Developer Tools & Offload Readiness
    echo ""
    echo "🛠️  Developer Tools & Offload Readiness:"
    _check_tool() {
        local name="$1"
        local cmd="$2"
        local path_target="$3"

        if command -v "$cmd" >/dev/null 2>&1; then
            if [ -n "$TARGET_DIR" ] && [ -d "$path_target" ]; then
                echo "   ✅ $name: Installed & active on satellite drive"
            elif [ -n "$TARGET_DIR" ]; then
                echo "   📦 $name: Installed (ready for offload)"
            else
                echo "   🔄 $name: Installed (currently falling back to internal SSD)"
            fi
        else
            echo "   ⚪ $name: Not installed (skipped)"
        fi
    }

    _check_tool "Homebrew" "brew" "$TARGET_DIR/Caches/Homebrew"
    _check_tool "Node.js (NPM)" "npm" "$TARGET_DIR/.npm-cache"
    _check_tool "PNPM" "pnpm" "$TARGET_DIR/.pnpm"
    _check_tool "Bun" "bun" "$TARGET_DIR/.bun-cache"
    _check_tool "Android SDK" "adb" "$TARGET_DIR/.android/avd"
    _check_tool "Gradle" "gradle" "$TARGET_DIR/.gradle"
    _check_tool "Rust (Cargo)" "cargo" "$TARGET_DIR/.cargo"
    _check_tool "Go" "go" "$TARGET_DIR/Caches/go-build"
    _check_tool "Ollama AI" "ollama" "$TARGET_DIR/ollama/models"
    _check_tool "Playwright" "npx" "$TARGET_DIR/Caches/ms-playwright"

    # Xcode DerivedData check
    if command -v xcodebuild >/dev/null 2>&1; then
        local xcode_loc
        xcode_loc=$(defaults read com.apple.dt.Xcode IDECustomDerivedDataLocation 2>/dev/null || echo "")
        if [ -n "$xcode_loc" ] && [ -n "$TARGET_DIR" ] && [[ "$xcode_loc" == "$TARGET_DIR"* ]]; then
            echo "   ✅ Xcode DerivedData: Offloaded to satellite drive ($xcode_loc)"
        else
            echo "   📦 Xcode: Installed (run 'orbit xcode-offload' to offload build artifacts)"
        fi
    fi

    # Docker & Container check
    if command -v docker >/dev/null 2>&1 || [ -d "$HOME/.orbstack" ]; then
        if [ -L "$HOME/.orbstack/data" ] || [ -L "$HOME/Library/Containers/com.docker.docker/Data/vms/0/Docker.raw" ] || [ -L "$HOME/Library/Containers/com.docker.docker/Data/vms/0/disk.raw" ]; then
            echo "   ✅ Container Storage: Offloaded to satellite drive"
        else
            echo "   📦 Containers (Docker/OrbStack): Installed (run 'orbit docker-offload' to offload VM disk)"
        fi
    fi

    echo ""
    echo "✨ Diagnostics complete! Everything is operational."
}

cmd_stats() {
    show_banner
    echo ""
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "🟡 External drive is currently UNDOCKED."
        echo "👉 Connect your external drive and run 'orbit stats' again to measure offloaded space."
        return 0
    fi

    echo "📊 Calculating satellite space offload..."
    python3 -c "
import os, subprocess

target = '$TARGET_DIR'

categories = [
    ('Installed Apps & Tools',   [f'{target}/Applications', f'{target}/dev-dbs', f'{target}/Claude-Data', f'{target}/Cursor-Data']),
    ('Docker & Container Disks', [f'{target}/Docker', f'{target}/OrbStack', f'{target}/OrbStackData']),
    ('Xcode & Simulators',       [f'{target}/Xcode', f'{target}/Developer']),
    ('System & Homebrew Caches', [f'{target}/Caches']),
    ('XDG & Developer Caches',   [f'{target}/.cache']),
    ('Node & Package Stores',    [f'{target}/.npm-cache', f'{target}/.pnpm', f'{target}/.bun-cache']),
    ('Android & Gradle',         [f'{target}/.android', f'{target}/.gradle']),
    ('Rust & Go Toolchains',     [f'{target}/.cargo', f'{target}/Caches/go-build']),
    ('AI & Model Weights',       [f'{target}/ollama', f'{target}/.cache/huggingface', f'{target}/.cache/torch']),
]

results = []
total_kb = 0

for label, paths in categories:
    cat_kb = 0
    for p in paths:
        if os.path.exists(p):
            try:
                res = subprocess.check_output(['du', '-sk', p], stderr=subprocess.DEVNULL).decode().split()[0]
                cat_kb += int(res)
            except Exception:
                pass
    if cat_kb > 0:
        results.append((label, cat_kb))
        total_kb += cat_kb

def fmt_size(kb):
    if kb >= 1024 * 1024:
        return f'{kb / (1024 * 1024):.2f} GB'
    elif kb >= 1024:
        return f'{kb / 1024:.1f} MB'
    else:
        return f'{kb} KB'

print('\n🛰️  Orbit-Disk Space Offload Report')
print(f'📍 Target Volume: {target}')
print('─' * 66)
print(f'{\"Category\":<28} {\"Size\":<12} {\"Share\"}')
print('─' * 66)

max_bar_width = 24
for label, kb in sorted(results, key=lambda x: x[1], reverse=True):
    pct = (kb / total_kb) if total_kb > 0 else 0
    bar_len = int(round(pct * max_bar_width))
    bar = '█' * bar_len + '░' * (max_bar_width - bar_len)
    print(f'{label:<28} {fmt_size(kb):<12} {bar} {int(pct*100):>3}%')

print('─' * 66)
print(f'🛡️  Total Space Kept Off Internal SSD: \033[1;36m{fmt_size(total_kb)}\033[0m\n')
" 2>/dev/null || {
        echo "External volume usage:"
        df -h "$TARGET_DIR"
    }

    if command -v df >/dev/null 2>&1; then
        local int_free ext_free
        int_free=$(df -h / | awk 'NR==2 {print $4}')
        ext_free=$(df -h "$TARGET_DIR" | awk 'NR==2 {print $4 " (" $5 " used)"}')
        echo "💾 Internal Mac SSD Free:  $int_free"
        echo "🛰️ Satellite Volume Free:  $ext_free"
        echo ""
    fi
}

cmd_xcode_offload() {
    show_banner
    echo ""
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "❌ Error: Satellite drive is not docked. Please connect external drive first."
        return 1
    fi

    echo "🔨 Configuring Xcode DerivedData Offload..."
    if pgrep -x "Xcode" >/dev/null 2>&1; then
        echo "⚠️  Xcode is currently running. Please save your work and quit Xcode before continuing."
        read -r -p "Press Enter once Xcode is closed (or Ctrl+C to cancel)..."
    fi

    local target_derived="$TARGET_DIR/Xcode/DerivedData"
    local local_derived="${HOME}/Library/Developer/Xcode/DerivedData"
    mkdir -p "$target_derived"
    touch "$TARGET_DIR/Xcode/.metadata_never_index" 2>/dev/null || true

    if [ -d "$local_derived" ] && [ "$(ls -A "$local_derived" 2>/dev/null)" ]; then
        local cur_size
        cur_size=$(du -sh "$local_derived" 2>/dev/null | cut -f1)
        echo "📦 Found local DerivedData build cache (${cur_size})."
        echo "🚀 Migrating existing DerivedData into orbit..."
        rsync -a --remove-source-files "$local_derived/" "$target_derived/" 2>/dev/null || true
        rm -rf "$local_derived"
    fi

    defaults write com.apple.dt.Xcode IDECustomDerivedDataLocation "$target_derived"
    echo "✅ Xcode DerivedData path successfully offloaded to: $target_derived"
    echo "🛡️  Spotlight indexing excluded to keep disk build performance peak."
    echo "💡 To restore to internal SSD at any time, run 'orbit xcode-restore'."
}

cmd_xcode_restore() {
    echo "🔄 Restoring Xcode DerivedData to internal Mac SSD..."
    defaults delete com.apple.dt.Xcode IDECustomDerivedDataLocation 2>/dev/null || true
    echo "✅ Xcode DerivedData reset to default internal storage (~/Library/Developer/Xcode/DerivedData)."
}

cmd_docker_offload() {
    show_banner
    echo ""
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "❌ Error: Satellite drive is not docked. Please connect external drive first."
        return 1
    fi

    echo "🐳 Preparing Container & Docker Offload..."

    # 1. OrbStack Support
    if [ -d "${HOME}/.orbstack" ]; then
        echo "Detected OrbStack installation."
        if pgrep -f "OrbStack" >/dev/null 2>&1; then
            echo "⚠️  OrbStack is currently running. Please quit OrbStack from menu bar first."
            read -r -p "Press Enter once OrbStack is closed (or Ctrl+C to cancel)..."
        fi

        local orb_target="$TARGET_DIR/OrbStack/data"
        local orb_local="${HOME}/.orbstack/data"
        mkdir -p "$TARGET_DIR/OrbStack"
        touch "$TARGET_DIR/OrbStack/.metadata_never_index" 2>/dev/null || true

        if [ -L "$orb_local" ]; then
            echo "ℹ️  OrbStack data is already symlinked to satellite drive: $(readlink "$orb_local")"
        elif [ -d "$orb_local" ]; then
            echo "📦 Moving OrbStack data ($(du -sh "$orb_local" 2>/dev/null | cut -f1)) to satellite drive..."
            mv "$orb_local" "$orb_target"
            ln -s "$orb_target" "$orb_local"
            echo "✅ OrbStack data offloaded and symlinked successfully!"
        fi
    fi

    # 2. Docker Desktop Support
    local docker_vm_dir="${HOME}/Library/Containers/com.docker.docker/Data/vms/0"
    if [ -d "$docker_vm_dir" ]; then
        echo "Detected Docker Desktop VM."
        if pgrep -f "Docker" >/dev/null 2>&1; then
            echo "⚠️  Docker Desktop is currently running. Please quit Docker first."
            read -r -p "Press Enter once Docker is closed (or Ctrl+C to cancel)..."
        fi

        local docker_target="$TARGET_DIR/Docker"
        mkdir -p "$docker_target"
        touch "$docker_target/.metadata_never_index" 2>/dev/null || true

        for disk_name in "Docker.raw" "disk.raw" "Docker.qcow2"; do
            local local_disk="$docker_vm_dir/$disk_name"
            local data_sub="$docker_vm_dir/data/$disk_name"
            for candidate in "$local_disk" "$data_sub"; do
                if [ -f "$candidate" ] && [ ! -L "$candidate" ]; then
                    echo "📦 Found Docker virtual disk: $candidate ($(du -sh "$candidate" 2>/dev/null | cut -f1))"
                    echo "Moving to $docker_target/$disk_name..."
                    mv "$candidate" "$docker_target/$disk_name"
                    ln -s "$docker_target/$disk_name" "$candidate"
                    echo "✅ Docker virtual disk offloaded and linked successfully!"
                fi
            done
        done
    fi

    echo "🎉 Container offloading configured! Launch Docker or OrbStack normally."
}

cmd_docker_restore() {
    echo "🔄 Restoring Docker / OrbStack back to internal SSD..."
    local orb_target="$TARGET_DIR/OrbStack/data"
    local orb_local="${HOME}/.orbstack/data"
    if [ -L "$orb_local" ] && [ -d "$orb_target" ]; then
        rm "$orb_local"
        mv "$orb_target" "$orb_local"
        echo "✅ OrbStack data restored to internal SSD."
    fi
}

show_help() {
    show_banner
    cat << EOF

Usage: orbit-disk <command> [arguments] (or: orbit <command>)

Commands:
  status             Show drive docking status and active cache offloading
  stats              Visual dashboard of space offloaded to external drive
  doctor             Run diagnostic health check on drive & dev toolchains
  xcode-offload      Relocate Xcode DerivedData build artifacts to external drive
  xcode-restore      Reset Xcode DerivedData back to internal Mac storage
  docker-offload     Relocate Docker Desktop & OrbStack VM disk to external drive
  docker-restore     Reset Docker / OrbStack virtual disk back to internal storage
  init               Interactively detect and dock external drive
  sweep              Sweep internal fallback caches into orbit (external drive)
  update             Update Orbit-Disk to the latest release from GitHub
  install-app <app>  Install a Homebrew cask to external drive & link to /Applications
  install-dmg <file> Install a downloaded DMG to external drive & link to /Applications
  clean-next         Clean all .next build folders in current project tree
  clean-modules      Clean all node_modules folders in current project tree
  help               Show this help message

Options:
  --version          Display version
EOF
}

case "$1" in
    status)             cmd_status ;;
    stats|space|summary)cmd_stats ;;
    doctor|check)       cmd_doctor ;;
    xcode-offload)      cmd_xcode_offload ;;
    xcode-restore)      cmd_xcode_restore ;;
    docker-offload)     cmd_docker_offload ;;
    docker-restore)     cmd_docker_restore ;;
    init)               cmd_init ;;
    sweep|sync)         cmd_sweep ;;
    update|upgrade)     cmd_update ;;
    install-app)        shift; cmd_install_app "$@" ;;
    install-dmg)        shift; cmd_install_dmg "$@" ;;
    clean-next)         cmd_clean_next ;;
    clean-modules)      cmd_clean_modules ;;
    --version|-v)       echo "orbit-disk v${ORBIT_VERSION}" ;;
    help|--help|-h|"")  show_help ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'orbit-disk help' for usage."
        exit 1
        ;;
esac
