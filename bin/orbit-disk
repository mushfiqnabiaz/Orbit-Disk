#!/usr/bin/env bash
# ==============================================================================
# Orbit-Disk - Satellite Storage & Cache Offloader for macOS Developers
# https://github.com/mushfiqnabiaz/Orbit-Disk
# ==============================================================================

set -e

ORBIT_VERSION="1.2.1"
CONFIG_FILE="${HOME}/.orbit-disk.conf"
LEGACY_CONF="${HOME}/.devdrive.conf"

# Backward compatibility with legacy conf
if [ ! -f "$CONFIG_FILE" ] && [ -f "$LEGACY_CONF" ]; then
    CONFIG_FILE="$LEGACY_CONF"
fi

# Default configuration
ORBIT_PATH="${ORBIT_PATH:-auto}"

# Default feature toggles
OFFLOAD_XDG_CACHE="${OFFLOAD_XDG_CACHE:-true}"
OFFLOAD_HOMEBREW="${OFFLOAD_HOMEBREW:-true}"
OFFLOAD_NPM="${OFFLOAD_NPM:-true}"
OFFLOAD_PNPM="${OFFLOAD_PNPM:-true}"
OFFLOAD_BUN="${OFFLOAD_BUN:-true}"
OFFLOAD_ANDROID="${OFFLOAD_ANDROID:-true}"
OFFLOAD_GRADLE="${OFFLOAD_GRADLE:-true}"
OFFLOAD_GO="${OFFLOAD_GO:-true}"
OFFLOAD_CARGO="${OFFLOAD_CARGO:-true}"
OFFLOAD_PLAYWRIGHT="${OFFLOAD_PLAYWRIGHT:-true}"
OFFLOAD_AI_MODELS="${OFFLOAD_AI_MODELS:-true}"

# Load user configuration if present
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

# Detect external drive if set to "auto"
get_drive_path() {
    if [ "$ORBIT_PATH" != "auto" ] && [ -n "$ORBIT_PATH" ] && [ -d "$ORBIT_PATH" ]; then
        echo "$ORBIT_PATH"
        return 0
    fi

    # Auto-detect mounted external volumes in /Volumes
    for vol in /Volumes/*; do
        if [ "$vol" = "/Volumes/Macintosh HD" ] || [ "$vol" = "/Volumes/Macintosh HD - Data" ] || [ ! -d "$vol" ]; then
            continue
        fi
        if [ -w "$vol" ] && [ ! -f "$vol/.read-only" ]; then
            echo "$vol"
            return 0
        fi
    done

    echo ""
    return 1
}

TARGET_DIR="$(get_drive_path || true)"

show_banner() {
    cat << EOF
   ____       __    _ __        ____  _     __  
  / __ \_____/ /_  (_) /_      / __ \(_)___/ /__
 / / / / ___/ __ \/ / __/_____/ / / / / ___/ //_/
/ /_/ / /  / /_/ / / /_/_____/ /_/ / (__  ) ,<   
\____/_/  /_.___/_/\__/     /_____/_/____/_/|_|  
                                                 
   Satellite Storage for macOS Developers (v${ORBIT_VERSION})
EOF
}

cmd_status() {
    show_banner
    echo ""
    echo "⚙️  Configuration: $CONFIG_FILE"
    
    if [ -n "$TARGET_DIR" ] && [ -d "$TARGET_DIR" ]; then
        echo "🟢 Drive Status:   DOCKED (In Orbit)"
        echo "📍 Target Volume:  $TARGET_DIR"
        
        if command -v df >/dev/null 2>&1; then
            echo "💾 Available:      $(df -h "$TARGET_DIR" | awk 'NR==2 {print $4 " (" $5 " used)"}')"
        fi
        
        echo ""
        echo "📦 Offloaded Cache Paths:"
        [ "$OFFLOAD_XDG_CACHE" = "true" ] && echo "   • XDG Cache:     $TARGET_DIR/.cache"
        [ "$OFFLOAD_HOMEBREW" = "true" ]  && echo "   • Homebrew:      $TARGET_DIR/Caches/Homebrew"
        [ "$OFFLOAD_NPM" = "true" ]       && echo "   • NPM Cache:     $TARGET_DIR/.npm-cache"
        [ "$OFFLOAD_PNPM" = "true" ]      && echo "   • PNPM Store:    $TARGET_DIR/.pnpm"
        [ "$OFFLOAD_BUN" = "true" ]       && echo "   • Bun Cache:     $TARGET_DIR/.bun-cache"
        [ "$OFFLOAD_ANDROID" = "true" ]   && echo "   • Android AVD:   $TARGET_DIR/.android/avd"
        [ "$OFFLOAD_GRADLE" = "true" ]    && echo "   • Gradle Home:   $TARGET_DIR/.gradle"
        [ "$OFFLOAD_GO" = "true" ]        && echo "   • Go Build:      $TARGET_DIR/Caches/go-build"
        [ "$OFFLOAD_CARGO" = "true" ]     && echo "   • Rust Cargo:    $TARGET_DIR/.cargo"
        [ "$OFFLOAD_PLAYWRIGHT" = "true" ]&& echo "   • Playwright:    $TARGET_DIR/Caches/ms-playwright"
        [ "$OFFLOAD_AI_MODELS" = "true" ] && echo "   • AI (Ollama/HF):$TARGET_DIR/ollama/models & $TARGET_DIR/.cache/huggingface"
        echo ""
        echo "🛡️  Spotlight Guard: Active (caches, emulators & DBs excluded from search churn)"
    else
        echo "🟡 Drive Status:   UNDOCKED (Zero-break internal fallback mode active)"
        echo "ℹ️  Caches are safely routed to internal drive until external drive is docked."
    fi
}

cmd_init() {
    show_banner
    echo ""
    echo "🔍 Scanning for connected external drives..."
    echo ""
    
    local options=()
    local i=1
    
    for vol in /Volumes/*; do
        if [ "$vol" = "/Volumes/Macintosh HD" ] || [ "$vol" = "/Volumes/Macintosh HD - Data" ] || [ ! -d "$vol" ]; then
            continue
        fi
        if [ -w "$vol" ]; then
            options+=("$vol")
            echo "   [$i] $vol ($(df -h "$vol" | awk 'NR==2 {print $4 " free"}'))"
            i=$((i + 1))
        fi
    done

    if [ ${#options[@]} -eq 0 ]; then
        echo "❌ No writable external storage found in /Volumes."
        echo "Please plug in an external drive and re-run 'orbit-disk init'."
        exit 1
    fi

    echo ""
    printf "Select target drive [1-%s] (Enter for [1]): " "${#options[@]}"
    if [ -t 0 ]; then
        read -r choice || choice=1
    elif [ -c /dev/tty ]; then
        read -r choice < /dev/tty 2>/dev/null || choice=1
    else
        choice=1
    fi
    choice="${choice:-1}"
    
    local selected_idx=$((choice - 1))
    local chosen_drive="${options[$selected_idx]}"

    if [ -z "$chosen_drive" ] || [ ! -d "$chosen_drive" ]; then
        echo "❌ Invalid selection."
        exit 1
    fi

    CONFIG_FILE="${HOME}/.orbit-disk.conf"
    echo "Saving settings to $CONFIG_FILE..."
    cat > "$CONFIG_FILE" << EOF
# Orbit-Disk configuration (v1.1.0)
ORBIT_PATH="$chosen_drive"

# Web & Package Caches
OFFLOAD_XDG_CACHE=true
OFFLOAD_HOMEBREW=true
OFFLOAD_NPM=true
OFFLOAD_PNPM=true
OFFLOAD_BUN=true

# Mobile & Android
OFFLOAD_ANDROID=true
OFFLOAD_GRADLE=true

# Language Runtimes & Testing
OFFLOAD_GO=true
OFFLOAD_CARGO=true
OFFLOAD_PLAYWRIGHT=true

# Local AI Models (Ollama, HuggingFace)
OFFLOAD_AI_MODELS=true

PREVENT_SPOTLIGHT_INDEXING=true
EOF

    # Prepare directories on target drive
    mkdir -p "$chosen_drive"/{.cache,.npm-cache,.pnpm,.bun-cache,.android/avd,.gradle,.cargo,Caches/Homebrew,Caches/go-build,Caches/ms-playwright,ollama/models,Projects,Applications,Xcode,Cursor-Data}
    touch "$chosen_drive/.cache/.metadata_never_index" 2>/dev/null || true
    touch "$chosen_drive/.android/.metadata_never_index" 2>/dev/null || true
    touch "$chosen_drive/.gradle/.metadata_never_index" 2>/dev/null || true
    touch "$chosen_drive/Xcode/.metadata_never_index" 2>/dev/null || true
    touch "$chosen_drive/Cursor-Data/.metadata_never_index" 2>/dev/null || true

    echo "✅ Successfully docked Orbit-Disk to: $chosen_drive"
    echo "💡 Run 'source ~/.zshrc' to apply."
}

cmd_sweep() {
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "⚠️  External drive not connected. Cannot sweep caches."
        exit 1
    fi

    echo "🧹 Sweeping internal fallback caches into orbit ($TARGET_DIR)..."
    python3 -c "
import os, shutil

def get_size(path):
    if os.path.isfile(path) or os.path.islink(path):
        try: return os.path.getsize(path)
        except: return 0
    total = 0
    for root, dirs, files in os.walk(path):
        for f in files:
            fp = os.path.join(root, f)
            try: total += os.path.getsize(fp)
            except: pass
    return total

def fmt_size(b):
    for u in ['B', 'KB', 'MB', 'GB']:
        if b < 1024.0: return f'{b:.1f} {u}'
        b /= 1024.0
    return f'{b:.1f} TB'

src = os.path.expanduser('~/.cache')
dst = os.path.join('$TARGET_DIR', '.cache')
moved = []

if os.path.exists(src) and os.path.exists(dst):
    for f in sorted(os.listdir(src)):
        if f.startswith('.'): continue
        s = os.path.join(src, f)
        d = os.path.join(dst, f)
        try:
            sz = get_size(s)
            if os.path.isdir(s):
                shutil.copytree(s, d, dirs_exist_ok=True)
                shutil.rmtree(s)
                moved.append((f, sz, 'folder'))
            elif os.path.isfile(s):
                shutil.copy2(s, d)
                os.remove(s)
                moved.append((f, sz, 'file'))
        except Exception:
            pass

pnpm_local = os.path.expanduser('~/.pnpm-store')
if os.path.exists(pnpm_local):
    try:
        sz = get_size(pnpm_local)
        shutil.rmtree(pnpm_local)
        moved.append(('.pnpm-store', sz, 'store'))
    except Exception:
        pass

if moved:
    print('📦 Shifted the following caches from internal drive to external SSD:')
    for name, size, kind in moved:
        print(f'   • {name} ({fmt_size(size)})')
    print(f'✅ Successfully swept {len(moved)} cache item(s)!')
else:
    print('✨ Internal drive is already clean. Nothing to sweep.')
"
}

cmd_link_apps() {
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "⚠️  External drive not connected."
        exit 1
    fi

    echo "🔗 Configuring Spotlight-ready application shims in /Applications..."
    python3 -c "
import os, sys, shutil, plistlib, subprocess

target = '$TARGET_DIR'
search_dirs = [target]
apps_dir = os.path.join(target, 'Applications')
if os.path.isdir(apps_dir):
    search_dirs.append(apps_dir)

def find_icon(app_path, icon_name):
    resources = os.path.join(app_path, 'Contents', 'Resources')
    if not os.path.isdir(resources):
        return None
    if icon_name:
        for cand in [icon_name, icon_name + '.icns', icon_name.replace('.icns', '') + '.icns']:
            cand_path = os.path.join(resources, cand)
            if os.path.exists(cand_path):
                return cand_path
    for f in os.listdir(resources):
        if f.endswith('.icns'):
            return os.path.join(resources, f)
    return None

# Clean up stale symlinks and deleted shims
for f in os.listdir('/Applications'):
    if not f.endswith('.app'):
        continue
    app_dir = os.path.join('/Applications', f)
    if os.path.islink(app_dir) and not os.path.exists(app_dir):
        try:
            os.unlink(app_dir)
            print(f'🧹 Cleaned broken symlink: {f}')
        except Exception:
            pass
    elif os.path.isdir(app_dir):
        launcher_bin = os.path.join(app_dir, 'Contents', 'MacOS', 'launcher')
        if os.path.exists(launcher_bin):
            try:
                with open(launcher_bin, 'r') as lf:
                    content = lf.read()
                for line in content.splitlines():
                    if line.startswith('TARGET=\"'):
                        src_target = line.split('\"')[1]
                        if src_target.startswith(target) and not os.path.exists(src_target):
                            shutil.rmtree(app_dir)
                            print(f'🧹 Cleaned removed app shim: {f}')
                        break
            except Exception:
                pass

count = 0
for s_dir in search_dirs:
    if not os.path.exists(s_dir):
        continue
    for f in sorted(os.listdir(s_dir)):
        if not f.endswith('.app'):
            continue
        src = os.path.join(s_dir, f)
        if not os.path.isdir(src):
            continue

        dst = os.path.join('/Applications', f)
        
        # Read source Info.plist
        src_plist_path = os.path.join(src, 'Contents', 'Info.plist')
        orig_plist = {}
        if os.path.exists(src_plist_path):
            try:
                with open(src_plist_path, 'rb') as plf:
                    orig_plist = plistlib.load(plf)
            except Exception:
                pass

        app_name = orig_plist.get('CFBundleDisplayName') or orig_plist.get('CFBundleName') or f.replace('.app', '')
        bundle_id = orig_plist.get('CFBundleIdentifier', f'com.orbit.shim.{f.replace(\".app\", \"\")}')
        icon_file = find_icon(src, orig_plist.get('CFBundleIconFile'))
        icon_name = os.path.basename(icon_file) if icon_file else 'AppIcon.icns'

        # If dst exists and is a symlink, replace it with shim
        if os.path.islink(dst):
            try:
                os.unlink(dst)
            except Exception:
                pass

        # Check if already a valid shim
        launcher_bin = os.path.join(dst, 'Contents', 'MacOS', 'launcher')
        if os.path.isdir(dst) and os.path.exists(launcher_bin):
            os.chmod(launcher_bin, 0o755)
            continue

        # If dst is an existing real local app (not a shim), don't overwrite
        if os.path.exists(dst):
            continue

        # Build native macOS shim
        os.makedirs(os.path.join(dst, 'Contents', 'MacOS'), exist_ok=True)
        os.makedirs(os.path.join(dst, 'Contents', 'Resources'), exist_ok=True)

        if icon_file and os.path.exists(icon_file):
            try:
                shutil.copy2(icon_file, os.path.join(dst, 'Contents', 'Resources', icon_name))
            except Exception:
                pass

        shim_plist = {
            'CFBundlePackageType': 'APPL',
            'CFBundleName': app_name,
            'CFBundleDisplayName': app_name,
            'CFBundleIdentifier': f'com.orbit.shim.{bundle_id}',
            'CFBundleExecutable': 'launcher',
            'CFBundleIconFile': icon_name,
            'LSUIElement': True,
        }

        try:
            with open(os.path.join(dst, 'Contents', 'Info.plist'), 'wb') as pf:
                plistlib.dump(shim_plist, pf)
        except Exception as e:
            print(f'⚠️  Could not write plist for {f}: {e}')
            continue

        launcher_sh = f'''#!/bin/bash
TARGET=\"{src}\"
if [ ! -d \"\$TARGET\" ]; then
    osascript -e 'display alert \"External Drive Disconnected\" message \"Please connect your external drive to launch {app_name}.\" as warning'
    exit 1
fi
exec open -a \"\$TARGET\" \"\$@\"
'''
        with open(launcher_bin, 'w') as lf:
            lf.write(launcher_sh)
        os.chmod(launcher_bin, 0o755)
        subprocess.run(['touch', dst], check=False)
        print(f'✅ Spotlight-ready shim: {f}')
        count += 1

if count == 0:
    print('ℹ️  All applications are already configured in /Applications.')
else:
    print(f'✨ Successfully configured {count} applications for Spotlight search.')
"
}

cmd_install_app() {
    local app="$1"
    if [ -z "$app" ]; then
        echo "Usage: orbit-disk install-app <cask-name>"
        exit 1
    fi
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "⚠️  External drive not connected."
        exit 1
    fi

    echo "📦 Installing $app to $TARGET_DIR via Homebrew..."
    brew install --cask --appdir="$TARGET_DIR" "$app"
    
    cmd_link_apps
    echo "🎉 Successfully installed and linked $app!"
}

cmd_install_dmg() {
    local dmg="$1"
    if [ -z "$dmg" ] || [ ! -f "$dmg" ]; then
        echo "❌ File not found: ${dmg:-<unspecified>}"
        echo "Usage: orbit-disk install-dmg <path-to-dmg>"
        exit 1
    fi
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "⚠️  External drive not connected."
        exit 1
    fi

    echo "📦 Mounting $(basename "$dmg")..."
    local mount_output
    mount_output=$(hdiutil attach "$dmg" -nobrowse -readonly 2>&1)
    
    local mount_point
    mount_point=$(echo "$mount_output" | sed -nE 's/.*(\/Volumes\/[^[:cntrl:]]*)/\1/p' | head -n 1 | sed 's/[[:space:]]*$//')

    if [ -z "$mount_point" ] || [ ! -d "$mount_point" ]; then
        echo "❌ Failed to mount DMG. Details:"
        echo "$mount_output"
        exit 1
    fi

    echo "📍 Mounted at: $mount_point"

    # Find .app bundles in the mounted volume
    local apps=()
    while IFS= read -r -d '' app_path; do
        apps+=("$app_path")
    done < <(find "$mount_point" -maxdepth 2 -name "*.app" -type d -print0)

    if [ ${#apps[@]} -eq 0 ]; then
        echo "❌ No .app bundle found in $mount_point."
        echo "⏏️ Ejecting $mount_point..."
        diskutil eject "$mount_point" 2>/dev/null || hdiutil detach "$mount_point" -force -quiet || true
        exit 1
    fi

    local copied_count=0
    for app_path in "${apps[@]}"; do
        local app_name
        app_name="$(basename "$app_path")"
        echo "🚀 Copying $app_name to $TARGET_DIR..."
        if cp -a "$app_path" "$TARGET_DIR/"; then
            copied_count=$((copied_count + 1))
            echo "✅ Successfully copied $app_name."
        else
            echo "❌ Failed to copy $app_name to $TARGET_DIR"
        fi
    done

    echo "⏏️ Ejecting $mount_point..."
    diskutil eject "$mount_point" 2>/dev/null || hdiutil detach "$mount_point" -force -quiet || true

    if [ "$copied_count" -gt 0 ]; then
        rm -f "$dmg"
        echo "🗑️ Cleaned up DMG file: $(basename "$dmg")"
    else
        echo "⚠️  No applications were copied. Preserving DMG installer."
        exit 1
    fi

    cmd_link_apps
    echo "🎉 Successfully installed and linked!"
}

cmd_clean_next() {
    echo "🧹 Removing all .next build caches in $(pwd)..."
    find . -name '.next' -type d -prune -exec rm -rf {} +
    echo "✅ Cleaned all .next build caches."
}

cmd_clean_modules() {
    echo "🧹 Removing all node_modules in $(pwd)..."
    find . -name 'node_modules' -type d -prune -exec rm -rf {} +
    echo "✅ Cleaned all node_modules."
}

cmd_update() {
    echo "🛰️ Checking for Orbit-Disk updates from GitHub..."
    local raw_base="https://raw.githubusercontent.com/mushfiqnabiaz/Orbit-Disk/main"
    local install_dir="${HOME}/.local/bin"
    local clone_dir="${HOME}/.orbit-disk"
    local plugin_dest="${HOME}/.orbit-disk.plugin.zsh"
    local alert_file="${HOME}/.orbit-disk-update-alert"

    local tmp_dir
    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' EXIT

    if curl -fsSL "${raw_base}/bin/orbit-disk" -o "${tmp_dir}/orbit-disk" && \
       curl -fsSL "${raw_base}/orbit-disk.plugin.zsh" -o "${tmp_dir}/orbit-disk.plugin.zsh"; then
        chmod +x "${tmp_dir}/orbit-disk"
        local new_ver
        new_ver="$("${tmp_dir}/orbit-disk" --version 2>/dev/null || echo "orbit-disk latest")"

        # Atomically install
        mkdir -p "$install_dir"
        mv "${tmp_dir}/orbit-disk" "${install_dir}/orbit-disk"
        ln -sf "${install_dir}/orbit-disk" "${install_dir}/orbit"
        cp "${tmp_dir}/orbit-disk.plugin.zsh" "$plugin_dest"

        # If git clone dir exists, sync it too
        if [ -d "$clone_dir/.git" ]; then
            (cd "$clone_dir" && git pull --quiet origin main 2>/dev/null || true)
        fi

        # Sync fish plugin if fish is configured
        if [ -d "${HOME}/.config/fish/conf.d" ]; then
            curl -fsSL "${raw_base}/orbit-disk.fish" -o "${HOME}/.config/fish/conf.d/orbit-disk.fish" 2>/dev/null || true
        fi

        rm -f "$alert_file"
        echo ""
        echo "🎉 Successfully updated to ${new_ver}!"
        echo "👉 Run 'source ~/.zshrc' to apply shell changes to this session."
    else
        echo "❌ Update failed: could not connect to GitHub repository."
        return 1
    fi
}

cmd_doctor() {
    show_banner
    echo ""
    echo "🩺 Orbit-Disk Diagnostic Health Check"
    echo "======================================"
    echo ""

    # 1. Configuration Check
    echo "⚙️  Configuration:"
    if [ -f "$CONFIG_FILE" ]; then
        echo "   ✅ Config file: $CONFIG_FILE"
        echo "      ORBIT_PATH is set to: $ORBIT_PATH"
    else
        echo "   ⚠️  No config file found at ~/.orbit-disk.conf (run 'orbit init')"
    fi

    # 2. Satellite Drive Health
    echo ""
    echo "🛰️  Satellite Volume Health:"
    if [ -n "$TARGET_DIR" ] && [ -d "$TARGET_DIR" ]; then
        echo "   ✅ Mounted & Active: $TARGET_DIR"

        local test_file="$TARGET_DIR/.orbit_rw_test_$$"
        if touch "$test_file" 2>/dev/null && rm -f "$test_file" 2>/dev/null; then
            echo "   ✅ Read/Write Permissions: Verified (Full RW access)"
        else
            echo "   ❌ Read/Write Permissions: FAILED (Volume may be read-only)"
        fi

        if command -v diskutil >/dev/null 2>&1; then
            local fs_type
            fs_type=$(diskutil info "$TARGET_DIR" 2>/dev/null | awk -F': ' '/Type \(Bundle\)|File System Personality/ {print $2}' | head -n 1)
            [ -n "$fs_type" ] && echo "   ℹ️  Filesystem: $fs_type"
        fi

        if command -v df >/dev/null 2>&1; then
            local free_vol
            free_vol=$(df -h "$TARGET_DIR" | awk 'NR==2 {print $4 " (" $5 " used)"}')
            echo "   💾 Available Space: $free_vol"
        fi
    else
        echo "   🟡 Drive is currently UNDOCKED"
        echo "      Orbit-Disk is active in transparent internal fallback mode."
        echo "      Caches and builds continue seamlessly without crashing."
    fi

    # 3. Shell Hook Integration
    echo ""
    echo "🐚 Shell Hook Check:"
    local zshrc="${HOME}/.zshrc"
    if [ -f "$zshrc" ] && grep -q "orbit-disk.plugin.zsh" "$zshrc"; then
        echo "   ✅ Zsh plugin hook present in ~/.zshrc"
    else
        echo "   ⚠️  Zsh hook missing in ~/.zshrc (run installer to add)"
    fi

    if [ -f "${HOME}/.orbit-disk.plugin.zsh" ]; then
        echo "   ✅ Plugin script exists at ~/.orbit-disk.plugin.zsh"
    else
        echo "   ⚠️  Plugin script not found at ~/.orbit-disk.plugin.zsh"
    fi

    # 4. Developer Tools & Offload Readiness
    echo ""
    echo "🛠️  Developer Tools & Offload Readiness:"
    _check_tool() {
        local name="$1"
        local cmd="$2"
        local path_target="$3"

        if command -v "$cmd" >/dev/null 2>&1; then
            if [ -n "$TARGET_DIR" ] && [ -d "$path_target" ]; then
                echo "   ✅ $name: Installed & active on satellite drive"
            elif [ -n "$TARGET_DIR" ]; then
                echo "   📦 $name: Installed (ready for offload)"
            else
                echo "   🔄 $name: Installed (currently falling back to internal SSD)"
            fi
        else
            echo "   ⚪ $name: Not installed (skipped)"
        fi
    }

    _check_tool "Homebrew" "brew" "$TARGET_DIR/Caches/Homebrew"
    _check_tool "Node.js (NPM)" "npm" "$TARGET_DIR/.npm-cache"
    _check_tool "PNPM" "pnpm" "$TARGET_DIR/.pnpm"
    _check_tool "Bun" "bun" "$TARGET_DIR/.bun-cache"
    _check_tool "Rust (Cargo)" "cargo" "$TARGET_DIR/.cargo"
    _check_tool "Go" "go" "$TARGET_DIR/Caches/go-build"
    _check_tool "Ollama AI" "ollama" "$TARGET_DIR/ollama/models"
    _check_tool "Playwright" "npx" "$TARGET_DIR/Caches/ms-playwright"

    # Android Studio check
    if [ -d "$HOME/.android" ] || [ -L "$HOME/.android" ]; then
        if [ -L "$HOME/.android" ]; then
            echo "   ✅ Android Studio: Offloaded to satellite drive (~/.android -> $(readlink "$HOME/.android"))"
        else
            echo "   📦 Android Studio: Installed on internal SSD (run 'orbit android-offload')"
        fi
    fi

    # Gradle check
    if [ -d "$HOME/.gradle" ] || [ -L "$HOME/.gradle" ]; then
        if [ -L "$HOME/.gradle" ]; then
            echo "   ✅ Gradle Caches & Wrapper: Offloaded to satellite drive (~/.gradle -> $(readlink "$HOME/.gradle"))"
        else
            echo "   📦 Gradle: Installed on internal SSD (run 'orbit gradle-offload')"
        fi
    fi

    # Cursor Editor check
    if [ -d "$HOME/.cursor" ] || [ -d "$HOME/Library/Application Support/Cursor" ] || [ -L "$HOME/.cursor" ]; then
        if [ -L "$HOME/.cursor" ] || [ -L "$HOME/Library/Application Support/Cursor" ]; then
            echo "   ✅ Cursor Editor: Offloaded to satellite drive"
        else
            echo "   📦 Cursor Editor: Installed on internal SSD (run 'orbit cursor-offload')"
        fi
    fi

    # Xcode & Simulator check
    if command -v xcodebuild >/dev/null 2>&1 || [ -d "$HOME/Library/Developer" ]; then
        local xcode_loc
        xcode_loc=$(defaults read com.apple.dt.Xcode IDECustomDerivedDataLocation 2>/dev/null || echo "")
        if [ -n "$xcode_loc" ] && [ -n "$TARGET_DIR" ] && [[ "$xcode_loc" == "$TARGET_DIR"* ]]; then
            echo "   ✅ Xcode DerivedData: Offloaded to satellite drive ($xcode_loc)"
        else
            echo "   📦 Xcode DerivedData: (run 'orbit xcode-offload')"
        fi
        if [ -L "$HOME/Library/Developer/CoreSimulator/Devices" ]; then
            echo "   ✅ Xcode Simulators: Offloaded to satellite drive"
        fi
    fi

    # Docker & Container check
    if command -v docker >/dev/null 2>&1 || [ -d "$HOME/.orbstack" ]; then
        if [ -L "$HOME/.orbstack/data" ] || [ -L "$HOME/Library/Containers/com.docker.docker/Data/vms/0/Docker.raw" ] || [ -L "$HOME/Library/Containers/com.docker.docker/Data/vms/0/disk.raw" ]; then
            echo "   ✅ Container Storage: Offloaded to satellite drive"
        else
            echo "   📦 Containers (Docker/OrbStack): Installed (run 'orbit docker-offload' to offload VM disk)"
        fi
    fi

    echo ""
    echo "✨ Diagnostics complete! Everything is operational."
}

cmd_stats() {
    show_banner
    echo ""
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "🟡 External drive is currently UNDOCKED."
        echo "👉 Connect your external drive and run 'orbit stats' again to measure offloaded space."
        return 0
    fi

    echo "📊 Calculating satellite space offload..."
    python3 -c "
import os, subprocess

target = '$TARGET_DIR'

categories = [
    ('Installed Apps & Tools',   [f'{target}/Applications', f'{target}/dev-dbs', f'{target}/Claude-Data', f'{target}/Cursor-Data']),
    ('Docker & Container Disks', [f'{target}/Docker', f'{target}/OrbStack', f'{target}/OrbStackData']),
    ('Xcode & Simulators',       [f'{target}/Xcode', f'{target}/Developer']),
    ('System & Homebrew Caches', [f'{target}/Caches']),
    ('XDG & Developer Caches',   [f'{target}/.cache']),
    ('Node & Package Stores',    [f'{target}/.npm-cache', f'{target}/.pnpm', f'{target}/.bun-cache']),
    ('Android & Gradle',         [f'{target}/.android', f'{target}/.gradle']),
    ('Rust & Go Toolchains',     [f'{target}/.cargo', f'{target}/Caches/go-build']),
    ('AI & Model Weights',       [f'{target}/ollama', f'{target}/.cache/huggingface', f'{target}/.cache/torch']),
]

results = []
total_kb = 0

for label, paths in categories:
    cat_kb = 0
    for p in paths:
        if os.path.exists(p):
            try:
                res = subprocess.check_output(['du', '-sk', p], stderr=subprocess.DEVNULL).decode().split()[0]
                cat_kb += int(res)
            except Exception:
                pass
    if cat_kb > 0:
        results.append((label, cat_kb))
        total_kb += cat_kb

def fmt_size(kb):
    if kb >= 1024 * 1024:
        return f'{kb / (1024 * 1024):.2f} GB'
    elif kb >= 1024:
        return f'{kb / 1024:.1f} MB'
    else:
        return f'{kb} KB'

print('\n🛰️  Orbit-Disk Space Offload Report')
print(f'📍 Target Volume: {target}')
print('─' * 66)
print(f'{\"Category\":<28} {\"Size\":<12} {\"Share\"}')
print('─' * 66)

max_bar_width = 24
for label, kb in sorted(results, key=lambda x: x[1], reverse=True):
    pct = (kb / total_kb) if total_kb > 0 else 0
    bar_len = int(round(pct * max_bar_width))
    bar = '█' * bar_len + '░' * (max_bar_width - bar_len)
    print(f'{label:<28} {fmt_size(kb):<12} {bar} {int(pct*100):>3}%')

print('─' * 66)
print(f'🛡️  Total Space Kept Off Internal SSD: \033[1;36m{fmt_size(total_kb)}\033[0m\n')
" 2>/dev/null || {
        echo "External volume usage:"
        df -h "$TARGET_DIR"
    }

    if command -v df >/dev/null 2>&1; then
        local int_free ext_free
        int_free=$(df -h / | awk 'NR==2 {print $4}')
        ext_free=$(df -h "$TARGET_DIR" | awk 'NR==2 {print $4 " (" $5 " used)"}')
        echo "💾 Internal Mac SSD Free:  $int_free"
        echo "🛰️ Satellite Volume Free:  $ext_free"
        echo ""
    fi
}

cmd_xcode_offload() {
    show_banner
    echo ""
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "❌ Error: Satellite drive is not docked. Please connect external drive first."
        return 1
    fi

    echo "🔨 Configuring Xcode, Simulators & Build Artifacts Offload..."
    if pgrep -x "Xcode" >/dev/null 2>&1; then
        echo "⚠️  Xcode is currently running. Please save your work and quit Xcode before continuing."
        read -r -p "Press Enter once Xcode is closed (or Ctrl+C to cancel)..."
    fi

    # Terminate Simulator daemon if running
    killall -9 com.apple.CoreSimulator.CoreSimulatorService 2>/dev/null || true

    mkdir -p "$TARGET_DIR/Xcode"
    touch "$TARGET_DIR/Xcode/.metadata_never_index" 2>/dev/null || true

    # 1. DerivedData
    local target_derived="$TARGET_DIR/Xcode/DerivedData"
    local local_derived="${HOME}/Library/Developer/Xcode/DerivedData"
    mkdir -p "$target_derived"

    if [ -d "$local_derived" ] && [ "$(ls -A "$local_derived" 2>/dev/null)" ]; then
        local cur_size
        cur_size=$(du -sh "$local_derived" 2>/dev/null | cut -f1)
        echo "📦 Found local DerivedData build cache (${cur_size})."
        echo "🚀 Migrating existing DerivedData into orbit..."
        rsync -a --remove-source-files "$local_derived/" "$target_derived/" 2>/dev/null || true
        rm -rf "$local_derived"
    fi

    defaults write com.apple.dt.Xcode IDECustomDerivedDataLocation "$target_derived"
    echo "✅ Xcode DerivedData path offloaded to: $target_derived"

    # 2. CoreSimulator Devices (~16+ GB)
    local local_sim="${HOME}/Library/Developer/CoreSimulator/Devices"
    local target_sim="$TARGET_DIR/Xcode/CoreSimulator/Devices"
    mkdir -p "$TARGET_DIR/Xcode/CoreSimulator"

    if [ -L "$local_sim" ]; then
        echo "ℹ️  CoreSimulator Devices is already symlinked to: $(readlink "$local_sim")"
    elif [ -d "$local_sim" ]; then
        local sim_size
        sim_size=$(du -sh "$local_sim" 2>/dev/null | cut -f1)
        echo "📱 Found local Simulator devices (${sim_size})."
        echo "🚀 Offloading Simulator devices to satellite drive..."
        mkdir -p "$target_sim"
        rsync -a "$local_sim/" "$target_sim/" && rm -rf "$local_sim"
        ln -s "$target_sim" "$local_sim"
        echo "✅ Simulator devices offloaded and symlinked successfully!"
    fi

    # 3. iOS DeviceSupport (~6 GB symbols for physically debugged iPhones/iPads)
    local local_devsup="${HOME}/Library/Developer/Xcode/iOS DeviceSupport"
    local target_devsup="$TARGET_DIR/Xcode/iOS DeviceSupport"

    if [ -L "$local_devsup" ]; then
        echo "ℹ️  iOS DeviceSupport is already symlinked to: $(readlink "$local_devsup")"
    elif [ -d "$local_devsup" ]; then
        local devsup_size
        devsup_size=$(du -sh "$local_devsup" 2>/dev/null | cut -f1)
        echo "📱 Found iOS DeviceSupport symbols (${devsup_size})."
        echo "🚀 Offloading iOS DeviceSupport to satellite drive..."
        mkdir -p "$target_devsup"
        rsync -a "$local_devsup/" "$target_devsup/" && rm -rf "$local_devsup"
        ln -s "$target_devsup" "$local_devsup"
        echo "✅ iOS DeviceSupport offloaded and symlinked successfully!"
    fi

    # 4. Clean Xcode Git source control caches
    local xcode_git_cache="${HOME}/Library/Caches/com.apple.dt.Xcode.sourcecontrol.Git"
    if [ -d "$xcode_git_cache" ]; then
        rm -rf "$xcode_git_cache"
        echo "🧹 Cleaned Xcode Git source control cache."
    fi

    echo "🛡️  Spotlight indexing excluded to keep disk build performance peak."
    echo "💡 To restore to internal SSD at any time, run 'orbit xcode-restore'."
}

cmd_xcode_restore() {
    echo "🔄 Restoring Xcode settings and caches to internal Mac SSD..."
    defaults delete com.apple.dt.Xcode IDECustomDerivedDataLocation 2>/dev/null || true
    echo "✅ Xcode DerivedData reset to default internal storage (~/Library/Developer/Xcode/DerivedData)."

    local local_sim="${HOME}/Library/Developer/CoreSimulator/Devices"
    if [ -L "$local_sim" ]; then
        local target_sim="$(readlink "$local_sim")"
        [ -z "$target_sim" ] && target_sim="$TARGET_DIR/Xcode/CoreSimulator/Devices"
        if [ -d "$target_sim" ]; then
            echo "📦 Restoring Simulators to internal SSD..."
            local tmp_sim="${local_sim}.restoring_$$"
            if rsync -a "$target_sim/" "$tmp_sim/"; then
                rm "$local_sim"
                mv "$tmp_sim" "$local_sim"
                echo "✅ CoreSimulator Devices restored to internal SSD."
            else
                rm -rf "$tmp_sim"
                echo "❌ Failed to copy Simulators back. Symlink preserved."
            fi
        else
            echo "⚠️  Simulator target ($target_sim) not mounted/found. Please connect external drive."
        fi
    fi

    local local_devsup="${HOME}/Library/Developer/Xcode/iOS DeviceSupport"
    if [ -L "$local_devsup" ]; then
        local target_devsup="$(readlink "$local_devsup")"
        [ -z "$target_devsup" ] && target_devsup="$TARGET_DIR/Xcode/iOS DeviceSupport"
        if [ -d "$target_devsup" ]; then
            echo "📦 Restoring iOS DeviceSupport symbols to internal SSD..."
            local tmp_devsup="${local_devsup}.restoring_$$"
            if rsync -a "$target_devsup/" "$tmp_devsup/"; then
                rm "$local_devsup"
                mv "$tmp_devsup" "$local_devsup"
                echo "✅ iOS DeviceSupport restored to internal SSD."
            else
                rm -rf "$tmp_devsup"
                echo "❌ Failed to copy iOS DeviceSupport back. Symlink preserved."
            fi
        else
            echo "⚠️  iOS DeviceSupport target ($target_devsup) not mounted/found. Please connect external drive."
        fi
    fi
}

cmd_android_offload() {
    show_banner
    echo ""
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "❌ Error: Satellite drive is not docked. Please connect external drive first."
        return 1
    fi

    echo "🤖 Configuring Android Studio & Emulator Offload..."
    if pgrep -f "emulator|Android Studio" >/dev/null 2>&1; then
        echo "⚠️  Android Studio or Android Emulator is currently running."
        echo "   Please quit Android Studio and close running emulators before continuing."
        read -r -p "Press Enter once closed (or Ctrl+C to cancel)..."
    fi

    local local_android="${HOME}/.android"
    local target_android="$TARGET_DIR/.android"
    mkdir -p "$target_android"
    touch "$target_android/.metadata_never_index" 2>/dev/null || true

    if [ -L "$local_android" ]; then
        echo "ℹ️  ~/.android is already symlinked to: $(readlink "$local_android")"
    elif [ -d "$local_android" ]; then
        local cur_size
        cur_size=$(du -sh "$local_android" 2>/dev/null | cut -f1)
        echo "📦 Found local Android directory (${cur_size})."
        echo "🚀 Offloading ~/.android to satellite drive..."
        rsync -a "$local_android/" "$target_android/" && rm -rf "$local_android"
        ln -s "$target_android" "$local_android"
        echo "✅ ~/.android offloaded and symlinked successfully!"
    else
        ln -s "$target_android" "$local_android"
        echo "✅ ~/.android symlinked to $target_android."
    fi

    echo "🎉 Android Studio AVD emulators and build cache now run directly on satellite drive!"
    echo "💡 To restore to internal SSD at any time, run 'orbit android-restore'."
}

cmd_android_restore() {
    echo "🔄 Restoring Android Studio ~/.android to internal SSD..."
    local local_android="${HOME}/.android"
    if [ ! -L "$local_android" ]; then
        echo "ℹ️  ~/.android is not currently offloaded as a symlink."
        return 0
    fi

    local target_android="$(readlink "$local_android")"
    [ -z "$target_android" ] && target_android="$TARGET_DIR/.android"

    if [ ! -d "$target_android" ]; then
        echo "❌ Cannot restore ~/.android: Target data on external drive ($target_android) is not mounted/found."
        echo "👉 Please connect your external drive first so data can be copied back."
        return 1
    fi

    echo "📦 Copying files back from external drive to internal SSD..."
    local tmp_backup="${HOME}/.android.restoring_$$"
    if rsync -a "$target_android/" "$tmp_backup/"; then
        rm "$local_android"
        mv "$tmp_backup" "$local_android"
        echo "✅ ~/.android successfully restored to internal SSD."
    else
        rm -rf "$tmp_backup"
        echo "❌ Failed to copy files back. Symlink preserved."
        return 1
    fi
}

