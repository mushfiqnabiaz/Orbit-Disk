cmd_cursor_offload() {
    show_banner
    echo ""
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "❌ Error: Satellite drive is not docked. Please connect external drive first."
        return 1
    fi

    echo "⚡ Configuring Cursor Editor Offload..."
    if pgrep -f "Cursor" >/dev/null 2>&1; then
        echo "⚠️  Cursor editor is currently running. Please save and quit Cursor first."
        read -r -p "Press Enter once Cursor is closed (or Ctrl+C to cancel)..."
    fi

    local target_cursor="$TARGET_DIR/Cursor-Data"
    mkdir -p "$target_cursor"
    touch "$target_cursor/.metadata_never_index" 2>/dev/null || true

    # 1. Clean disposable Electron caches first
    local app_support="${HOME}/Library/Application Support/Cursor"
    if [ -d "$app_support" ]; then
        echo "🧹 Clearing disposable Electron caches (Cache, Code Cache, GPUCache)..."
        rm -rf "$app_support/Cache" \
               "$app_support/CachedData" \
               "$app_support/Code Cache" \
               "$app_support/GPUCache" \
               "$app_support/Service Worker/CacheStorage" 2>/dev/null || true
    fi

    # 2. Offload ~/.cursor (extensions & configuration)
    local local_cursor_home="${HOME}/.cursor"
    local target_cursor_home="$target_cursor/.cursor"
    if [ -L "$local_cursor_home" ]; then
        echo "ℹ️  ~/.cursor is already symlinked to: $(readlink "$local_cursor_home")"
    elif [ -d "$local_cursor_home" ]; then
        local c_size
        c_size=$(du -sh "$local_cursor_home" 2>/dev/null | cut -f1)
        echo "📦 Found ~/.cursor (${c_size}). Offloading to satellite drive..."
        mkdir -p "$target_cursor_home"
        rsync -a "$local_cursor_home/" "$target_cursor_home/" && rm -rf "$local_cursor_home"
        ln -s "$target_cursor_home" "$local_cursor_home"
        echo "✅ ~/.cursor offloaded and symlinked successfully!"
    fi

    # 3. Offload ~/Library/Application Support/Cursor
    local target_app_support="$target_cursor/Application Support/Cursor"
    if [ -L "$app_support" ]; then
        echo "ℹ️  Cursor Application Support is already symlinked to: $(readlink "$app_support")"
    elif [ -d "$app_support" ]; then
        local as_size
        as_size=$(du -sh "$app_support" 2>/dev/null | cut -f1)
        echo "📦 Found Cursor Application Support (${as_size}). Offloading..."
        mkdir -p "$target_cursor/Application Support"
        rsync -a "$app_support/" "$target_app_support/" && rm -rf "$app_support"
        ln -s "$target_app_support" "$app_support"
        echo "✅ Cursor Application Support offloaded and symlinked successfully!"
    fi

    echo "🎉 Cursor extensions, user configuration, and state now offloaded!"
    echo "💡 To restore to internal SSD at any time, run 'orbit cursor-restore'."
}

cmd_cursor_restore() {
    echo "🔄 Restoring Cursor editor data to internal SSD..."
    local local_cursor_home="${HOME}/.cursor"
    if [ -L "$local_cursor_home" ]; then
        local target_cursor_home="$(readlink "$local_cursor_home")"
        [ -z "$target_cursor_home" ] && target_cursor_home="$TARGET_DIR/Cursor-Data/.cursor"
        if [ -d "$target_cursor_home" ]; then
            echo "📦 Restoring ~/.cursor..."
            local tmp_ch="${local_cursor_home}.restoring_$$"
            if rsync -a "$target_cursor_home/" "$tmp_ch/"; then
                rm "$local_cursor_home"
                mv "$tmp_ch" "$local_cursor_home"
                echo "✅ ~/.cursor restored to internal SSD."
            else
                rm -rf "$tmp_ch"
            fi
        else
            echo "⚠️  ~/.cursor target ($target_cursor_home) not mounted/found."
        fi
    fi

    local app_support="${HOME}/Library/Application Support/Cursor"
    if [ -L "$app_support" ]; then
        local target_app_support="$(readlink "$app_support")"
        [ -z "$target_app_support" ] && target_app_support="$TARGET_DIR/Cursor-Data/Application Support/Cursor"
        if [ -d "$target_app_support" ]; then
            echo "📦 Restoring Cursor Application Support..."
            local tmp_as="${app_support}.restoring_$$"
            if rsync -a "$target_app_support/" "$tmp_as/"; then
                rm "$app_support"
                mv "$tmp_as" "$app_support"
                echo "✅ Cursor Application Support restored to internal SSD."
            else
                rm -rf "$tmp_as"
            fi
        else
            echo "⚠️  Cursor Application Support target ($target_app_support) not mounted/found."
        fi
    fi
}

cmd_docker_offload() {
    show_banner
    echo ""
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "❌ Error: Satellite drive is not docked. Please connect external drive first."
        return 1
    fi

    echo "🐳 Preparing Container & Docker Offload..."

    # 1. OrbStack Support
    if [ -d "${HOME}/.orbstack" ]; then
        echo "Detected OrbStack installation."
        if pgrep -f "OrbStack" >/dev/null 2>&1; then
            echo "⚠️  OrbStack is currently running. Please quit OrbStack from menu bar first."
            read -r -p "Press Enter once OrbStack is closed (or Ctrl+C to cancel)..."
        fi

        local orb_target="$TARGET_DIR/OrbStack/data"
        local orb_local="${HOME}/.orbstack/data"
        mkdir -p "$TARGET_DIR/OrbStack"
        touch "$TARGET_DIR/OrbStack/.metadata_never_index" 2>/dev/null || true

        if [ -L "$orb_local" ]; then
            echo "ℹ️  OrbStack data is already symlinked to satellite drive: $(readlink "$orb_local")"
        elif [ -d "$orb_local" ]; then
            echo "📦 Moving OrbStack data ($(du -sh "$orb_local" 2>/dev/null | cut -f1)) to satellite drive..."
            mv "$orb_local" "$orb_target"
            ln -s "$orb_target" "$orb_local"
            echo "✅ OrbStack data offloaded and symlinked successfully!"
        fi
    fi

    # 2. Docker Desktop Support
    local docker_vm_dir="${HOME}/Library/Containers/com.docker.docker/Data/vms/0"
    if [ -d "$docker_vm_dir" ]; then
        echo "Detected Docker Desktop VM."
        if pgrep -f "Docker" >/dev/null 2>&1; then
            echo "⚠️  Docker Desktop is currently running. Please quit Docker first."
            read -r -p "Press Enter once Docker is closed (or Ctrl+C to cancel)..."
        fi

        local docker_target="$TARGET_DIR/Docker"
        mkdir -p "$docker_target"
        touch "$docker_target/.metadata_never_index" 2>/dev/null || true

        for disk_name in "Docker.raw" "disk.raw" "Docker.qcow2"; do
            local local_disk="$docker_vm_dir/$disk_name"
            local data_sub="$docker_vm_dir/data/$disk_name"
            for candidate in "$local_disk" "$data_sub"; do
                if [ -f "$candidate" ] && [ ! -L "$candidate" ]; then
                    echo "📦 Found Docker virtual disk: $candidate ($(du -sh "$candidate" 2>/dev/null | cut -f1))"
                    echo "Moving to $docker_target/$disk_name..."
                    mv "$candidate" "$docker_target/$disk_name"
                    ln -s "$docker_target/$disk_name" "$candidate"
                    echo "✅ Docker virtual disk offloaded and linked successfully!"
                fi
            done
        done
    fi

    echo "🎉 Container offloading configured! Launch Docker or OrbStack normally."
}

cmd_docker_restore() {
    echo "🔄 Restoring Docker / OrbStack back to internal SSD..."
    local orb_target="$TARGET_DIR/OrbStack/data"
    local orb_local="${HOME}/.orbstack/data"
    if [ -L "$orb_local" ] && [ -d "$orb_target" ]; then
        rm "$orb_local"
        mv "$orb_target" "$orb_local"
        echo "✅ OrbStack data restored to internal SSD."
    fi

    local docker_vm_dir="${HOME}/Library/Containers/com.docker.docker/Data/vms/0"
    local docker_target="$TARGET_DIR/Docker"
    if [ -d "$docker_vm_dir" ] && [ -d "$docker_target" ]; then
        for disk_name in "Docker.raw" "disk.raw" "Docker.qcow2"; do
            local cand="$docker_vm_dir/$disk_name"
            if [ -L "$cand" ] && [ -f "$docker_target/$disk_name" ]; then
                rm "$cand"
                mv "$docker_target/$disk_name" "$cand"
                echo "✅ Docker disk $disk_name restored to internal SSD."
            fi
        done
    fi
}

cmd_offload_all() {
    show_banner
    echo ""
    if [ -z "$TARGET_DIR" ] || [ ! -d "$TARGET_DIR" ]; then
        echo "❌ Error: Satellite drive is not docked. Please connect external drive first."
        return 1
    fi

    echo "🚀 Starting Full Satellite Offload Suite..."
    echo "Target volume: $TARGET_DIR"
    echo ""

    # 1. Android Studio & Emulators
    if [ -d "${HOME}/.android" ] && [ ! -L "${HOME}/.android" ]; then
        echo "▶️  Step 1/6: Offloading Android Studio & Emulators..."
        cmd_android_offload
        echo ""
    fi

    # 2. Gradle
    if [ -d "${HOME}/.gradle" ] && [ ! -L "${HOME}/.gradle" ]; then
        echo "▶️  Step 2/6: Offloading Gradle Caches & Wrappers..."
        cmd_gradle_offload
        echo ""
    fi

    # 3. Xcode & Simulators
    if [ -d "${HOME}/Library/Developer" ]; then
        echo "▶️  Step 3/6: Offloading Xcode Simulators & Build Artifacts..."
        cmd_xcode_offload
        echo ""
    fi

    # 4. Cursor Editor
    if [ -d "${HOME}/.cursor" ] || [ -d "${HOME}/Library/Application Support/Cursor" ]; then
        echo "▶️  Step 4/6: Offloading Cursor Editor Data..."
        cmd_cursor_offload
        echo ""
    fi

    # 5. Containers (Docker / OrbStack)
    if [ -d "${HOME}/.orbstack" ] || [ -d "${HOME}/Library/Containers/com.docker.docker" ]; then
        echo "▶️  Step 5/6: Offloading Containers & VM Disks..."
        cmd_docker_offload
        echo ""
    fi

    # 6. Global Cache Sweep
    echo "▶️  Step 6/6: Sweeping remaining build caches..."
    cmd_sweep
    echo ""

    # Final Visual Dashboard
    echo "🎉 Complete offload finished! Here is your satellite storage breakdown:"
    cmd_stats
}

cmd_rollback_all() {
    show_banner
    echo ""
    echo "🔄 Rolling back all offloaded tools to internal Mac SSD..."
    echo "This will safely move Xcode, Simulators, Android, Gradle, Cursor & Docker back to internal storage."
    echo ""

    cmd_android_restore
    cmd_gradle_restore
    cmd_xcode_restore
    cmd_cursor_restore
    cmd_docker_restore

    echo ""
    echo "🎉 Complete rollback finished! All tools are now restored to internal Mac storage."
}

show_help() {
    show_banner
    cat << EOF

Usage: orbit-disk <command> [arguments] (or: orbit <command>)

Offload Commands (Relocate massive caches to external drive):
  offload-all        One-command master suite: offload Xcode, Simulators, Android, Gradle, Cursor & Docker
  android-offload    Relocate Android Studio & AVD emulators (~/.android) to external drive
  gradle-offload     Relocate Gradle caches & wrappers (~/.gradle) to external drive
  xcode-offload      Relocate Xcode DerivedData, CoreSimulator Devices & iOS DeviceSupport
  cursor-offload     Relocate Cursor editor extensions & Application Support data to external drive
  docker-offload     Relocate Docker Desktop & OrbStack VM disk to external drive

Rollback & Restores (Safely restore tools back to internal Mac SSD):
  rollback           One-command rollback: restore ALL offloaded tools back to internal Mac SSD
  android-restore    Reset Android Studio ~/.android back to internal Mac storage
  gradle-restore     Reset Gradle ~/.gradle back to internal Mac storage
  xcode-restore      Reset Xcode settings, Simulators and DerivedData back to internal Mac storage
  cursor-restore     Reset Cursor editor data back to internal Mac storage
  docker-restore     Reset Docker / OrbStack virtual disk back to internal storage

Monitoring & Management:
  status             Show drive docking status and active cache offloading
  stats              Visual dashboard of space offloaded to external drive
  doctor             Run diagnostic health check on drive & dev toolchains
  init               Interactively detect and dock external drive
  sweep              Sweep internal fallback caches into orbit (external drive)
  update             Update Orbit-Disk to the latest release from GitHub

App Store & Cleaners:
  install-app <app>  Install a Homebrew cask to external drive & link to /Applications
  install-dmg <file> Install a downloaded DMG to external drive & link to /Applications
  link-apps          Scan external drive for .app bundles and link to /Applications
  clean-next         Clean all .next build folders in current project tree
  clean-modules      Clean all node_modules folders in current project tree
  help               Show this help message

Options:
  --version          Display version
EOF
}

case "$1" in
    status)             cmd_status ;;
    stats|space|summary)cmd_stats ;;
    doctor|check)       cmd_doctor ;;
    offload-all|offload)cmd_offload_all ;;
    rollback|restore-all)cmd_rollback_all ;;
    android-offload|android) cmd_android_offload ;;
    android-restore)    cmd_android_restore ;;
    gradle-offload|gradle)   cmd_gradle_offload ;;
    gradle-restore)     cmd_gradle_restore ;;
    xcode-offload|xcode)     cmd_xcode_offload ;;
    xcode-restore)      cmd_xcode_restore ;;
    cursor-offload|cursor)   cmd_cursor_offload ;;
    cursor-restore)     cmd_cursor_restore ;;
    docker-offload|docker)   cmd_docker_offload ;;
    docker-restore)     cmd_docker_restore ;;
    init)               cmd_init ;;
    sweep|sync)         cmd_sweep ;;
    update|upgrade)     cmd_update ;;
    install-app)        shift; cmd_install_app "$@" ;;
    install-dmg)        shift; cmd_install_dmg "$@" ;;
    link-apps)          cmd_link_apps ;;
    clean-next)         cmd_clean_next ;;
    clean-modules)      cmd_clean_modules ;;
    --version|-v)       echo "orbit-disk v${ORBIT_VERSION}" ;;
    help|--help|-h|"")  show_help ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'orbit-disk help' for usage."
        exit 1
        ;;
esac
