[0.000, "o", "\u001b[1;32m🟢 Drive Status:   DOCKED (In Orbit)\u001b[0m\r\n📍 Target Volume:  /Volumes/External\r\n💾 Available:      156Gi (33% used)\r\n\r\n\u001b[1m📦 Offloaded Cache Paths:\u001b[0m\r\n   • \u001b[1;36mXDG Cache:\u001b[0m     /Volumes/External/.cache\r\n   • \u001b[1;36mHomebrew:\u001b[0m      /Volumes/External/Caches/Homebrew\r\n"]
[0.000, "o", "   • \u001b[1;36mNPM Cache:\u001b[0m     /Volumes/External/.npm-cache\r\n   • \u001b[1;36mPNPM Store:\u001b[0m    /Volumes/External/.pnpm\r\n"]
