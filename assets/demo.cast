[0.000, "o", "   • \u001b[1;36mRust Cargo:\u001b[0m    /Volumes/External/.cargo\r\n"]
[0.000, "o", "   • \u001b[1;36mPlaywright:\u001b[0m    /Volumes/External/Caches/ms-playwright\r\n   • \u001b[1;35mAI (Ollama/HF):\u001b[0m/Volumes/External/ollama/models & /Volumes/External/.cache/huggingface\r\n\r\n\u001b[1;32m🛡️  Spotlight Guard: Active (caches, emulators & DBs excluded from search churn)\u001b[0m\r\n"]
